# Supabase (Project Settings -> API). Safe to expose; these are public client keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local dev only: bypass Supabase auth using the FastAPI X-Dev-User header.
NEXT_PUBLIC_DEV_USER_ID=
