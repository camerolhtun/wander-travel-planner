ENVIRONMENT=development

# --- Database ---------------------------------------------------------------
# Local:    postgresql+asyncpg://<user>@localhost:5432/travel_planner
# Supabase: Project Settings -> Database -> Connection string -> URI.
#   Use the "Session pooler" or direct connection (port 5432), NOT the
#   transaction pooler (6543). Change the scheme to postgresql+asyncpg://
#   and URL-encode any special characters in the password.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# --- Supabase auth --------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co  (Project Settings -> API)
# Used to fetch the JWKS for verifying asymmetric (ES256) access tokens.
SUPABASE_URL=

# Legacy HS256 shared secret (Project Settings -> API -> JWT Settings -> JWT Secret).
# Only needed if your project still issues HS256 tokens. New projects use JWKS
# and can leave this blank.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- AI ----------------------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey
# Leave blank to return a deterministic mock itinerary (whole flow still works).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Maps (optional) -------------------------------------------------------
# Google Cloud Console -> enable "Places API (New)" -> create an API key.
# Leave blank to skip place enrichment (lat/lng/address).
GOOGLE_PLACES_API_KEY=

# --- CORS ------------------------------------------------------------------
# JSON array. Add your deployed frontend URL for production.
CORS_ORIGINS=["http://localhost:3000"]
